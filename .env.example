TZ=Europe/Berlin
WEB_PORT=8080
SITE_TITLE=WG-Kalender
SITE_URL=http://localhost:8080/

BAIKAL_ADMIN_PASSWORD=change-this-admin-password
BAIKAL_WG_USERNAME=wg
BAIKAL_WG_EMAIL=wg@example.com
BAIKAL_WG_PASSWORD=change-this-calendar-password

# Optional; defaults to 0.10.1
BAIKAL_CONFIGURED_VERSION=0.10.1

# Base64 encoded credentials for the public calendar
# [Convert]::ToBase64String(
#    [Text.Encoding]::UTF8.GetBytes("BAIKAL_WG_USERNAME:BAIKAL_WG_PASSWORD")
#)
BAIKAL_PUBLIC_AUTH=BASE64_CREDENTIALS